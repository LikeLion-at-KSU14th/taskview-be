TASKVIEW_AI_URL=http://127.0.0.1:8100
TASKVIEW_AI_SHARED_SECRET=
TASKVIEW_DATABASE_URL=postgresql://taskview:taskview@127.0.0.1:54329/taskview
TASKVIEW_BE_FAKE_AI=false
TASKVIEW_SESSION_DAYS=7
TASKVIEW_LOGIN_MAX_FAILURES=5
TASKVIEW_LOGIN_LOCK_MINUTES=15
# 로컬 이메일 발송 대체용입니다. 운영 환경에서는 반드시 false로 유지하세요.
TASKVIEW_EXPOSE_DEV_TOKENS=false
TASKVIEW_REQUIRE_EMAIL_VERIFICATION=false
# `Fernet.generate_key()`로 환경별 키를 생성하고 비밀 저장소에서 주입하세요.
TASKVIEW_DELIVERY_ENCRYPTION_KEY=
TASKVIEW_PUBLIC_WEB_URL=http://localhost:3000
TASKVIEW_CORS_ORIGINS=http://localhost:3000
TASKVIEW_SMTP_HOST=127.0.0.1
TASKVIEW_SMTP_PORT=1025
TASKVIEW_SMTP_USERNAME=
TASKVIEW_SMTP_PASSWORD=
TASKVIEW_SMTP_FROM_EMAIL=Needex <no-reply@taskview.local>
TASKVIEW_SMTP_USE_TLS=false
TASKVIEW_SMTP_USE_STARTTLS=false
TASKVIEW_MAIL_WORKER_ENABLED=true
# 기본값은 fail-closed입니다. 운영 DB의 정확한 DNS 이름과 모든 허용 CIDR만 지정하세요.
TASKVIEW_DATA_SOURCE_ALLOWED_HOSTNAMES=
TASKVIEW_DATA_SOURCE_ALLOWED_CIDRS=
TASKVIEW_DATA_SOURCE_REQUIRE_TLS=true
TASKVIEW_DATA_SOURCE_VERIFY_TLS=true
TASKVIEW_DATA_SOURCE_TLS_CA_FILE=
TASKVIEW_DATA_SOURCE_CONNECT_TIMEOUT_SECONDS=3
TASKVIEW_DATA_SOURCE_COMMAND_TIMEOUT_SECONDS=3
TASKVIEW_DATA_SOURCE_CLOSE_TIMEOUT_SECONDS=1
TASKVIEW_DATA_SOURCE_MAX_CATALOG_FIELDS=5000
TASKVIEW_DATA_SOURCE_SCAN_JOB_TTL_SECONDS=900
# `Fernet.generate_key()`로 생성하고 비밀 저장소에서 주입하세요.
TASKVIEW_DATA_SOURCE_ENCRYPTION_KEY=
PORT=8200
