POSTGRES_DB=taskview
POSTGRES_USER=taskview
POSTGRES_PASSWORD=replace-with-a-url-safe-random-password

# 별도 taskview-ai 서버의 공개 HTTPS 주소와 동일한 공유 비밀
TASKVIEW_AI_URL=https://ai.example.com
TASKVIEW_AI_SHARED_SECRET=replace-with-the-same-ai-shared-secret

TASKVIEW_PUBLIC_WEB_URL=https://taskview.example.com
TASKVIEW_CORS_ORIGINS=https://taskview.example.com
BE_BIND_ADDRESS=0.0.0.0
BE_PORT=8200
NEEDEX_NETWORK=needex_internal

# `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
TASKVIEW_DELIVERY_ENCRYPTION_KEY=replace-with-fernet-key
TASKVIEW_DATA_SOURCE_ENCRYPTION_KEY=replace-with-another-fernet-key

TASKVIEW_SMTP_HOST=smtp.example.com
TASKVIEW_SMTP_PORT=587
TASKVIEW_SMTP_USERNAME=
TASKVIEW_SMTP_PASSWORD=
TASKVIEW_SMTP_FROM_EMAIL=Needex <no-reply@example.com>
TASKVIEW_SMTP_USE_TLS=false
TASKVIEW_SMTP_USE_STARTTLS=true

# 도메인·운영 SMTP 연결 전 로컬 Mailpit을 사용할 때만 true로 설정합니다.
TASKVIEW_USE_LOCAL_MAIL=false
TASKVIEW_REQUIRE_EMAIL_VERIFICATION=false
MAILPIT_BIND_ADDRESS=127.0.0.1
MAILPIT_UI_PORT=8025

# 선택 사항
TASKVIEW_DATA_SOURCE_ALLOWED_HOSTNAMES=
TASKVIEW_DATA_SOURCE_ALLOWED_CIDRS=
TASKVIEW_DATA_SOURCE_REQUIRE_TLS=true
TASKVIEW_DATA_SOURCE_VERIFY_TLS=true
TASKVIEW_DATA_SOURCE_TLS_CA_FILE=
